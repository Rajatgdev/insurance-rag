# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Neon Postgres (async driver for the app, sync for migrations/ingest)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST.neon.tech/DBNAME
DATABASE_URL_SYNC=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME

# OpenAI
OPENAI_API_KEY=sk-...

# CORS (add your Vercel URL when deployed)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
